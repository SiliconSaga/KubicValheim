/.idea

# Generated per-instance overlays from scripts/create-server.sh — keep only the
# curated examples (plain, gitops, valheim7). Ad-hoc instances aren't committed by accident.
kustomize/overlays/*/
!kustomize/overlays/plain/
!kustomize/overlays/gitops/
!kustomize/overlays/valheim7/
!kustomize/overlays/twinhenge/
!kustomize/overlays/valheim3/

# ...but a real instance's rendered Secret never lands in Git. scripts/render-secret.sh
# writes this from $VALHEIM_SERVER_PASSWORD at deploy time. (overlays/plain/secret.yaml
# is tracked-but-empty as a template and is unaffected by this rule.)
kustomize/overlays/valheim7/secret.yaml
kustomize/overlays/twinhenge/secret.yaml
kustomize/overlays/valheim3/secret.yaml

# Local docker env with a real password (never commit secrets)
docker/.env
