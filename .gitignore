/.idea

# Generated per-instance overlays from scripts/start-server.sh — keep only the
# curated examples (plain, gitops, event). Ad-hoc instances aren't committed by accident.
kustomize/overlays/*/
!kustomize/overlays/plain/
!kustomize/overlays/gitops/
!kustomize/overlays/event/

# ...but a real instance's rendered Secret never lands in Git. scripts/render-secret.sh
# writes this from $VALHEIM_SERVER_PASSWORD at deploy time. (overlays/plain/secret.yaml
# is tracked-but-empty as a template and is unaffected by this rule.)
kustomize/overlays/event/secret.yaml

# Local docker env with a real password (never commit secrets)
docker/.env
